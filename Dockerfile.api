# ============================
# 1) Dependencies
# ============================
FROM node:24-slim AS deps
WORKDIR /app/apps/api

# только манифесты API — быстрый кэш
COPY apps/api/package*.json ./

# строго по lock-файлу, без fallback на npm install
RUN npm ci

# ============================
# 2) Build (+ Prisma generate)
# ============================
FROM node:24-slim AS build
WORKDIR /app/apps/api

# зависимости
COPY --from=deps /app/apps/api/node_modules ./node_modules

# исходники API
COPY apps/api ./

# Prisma Client + сборка, чтобы seed попал в dist. prisma.config.ts требует DATABASE_URL даже для generate:
# подставляем заглушку только на время сборки (подключения к БД не происходит)
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" npx prisma generate \
    && npm run build

# оставляем только prod-зависимости
RUN npm prune --omit=dev

# ============================
# 3) Runtime
# ============================
FROM node:24-slim AS runner
ENV NODE_ENV=production
WORKDIR /app/apps/api

# аккуратное завершение + системные либы TLS
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini libssl3 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# минимальный рантайм
COPY --from=build /app/apps/api/package*.json ./
COPY --from=build /app/apps/api/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/prisma.config.ts ./prisma.config.ts

# слушать все интерфейсы в k8s
ENV HOST=0.0.0.0
EXPOSE 3000

ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","dist/src/main.js"]
