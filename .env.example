# API
DATABASE_URL="postgresql://afterlight:afterlight@db:5432/afterlight?schema=public"
JWT_SECRET="replace-with-64-char-random-hex-key-like-4f8b2d6a9c1e3f7b0d2a4c6e8f1a3b5d7c9e0a2b4d6f8a1c3e5b7d9f0a2c4e6"
NODE_ENV="production"
PORT=3000
DEFAULT_DEBUG_USER=""
CORS_ALLOWED_ORIGINS="http://localhost:3001"
JSON_BODY_LIMIT="100kb"

# WEB
# web проксирует /api/* в API. В docker-compose.server.yml по умолчанию http://api:3000 — НЕ задавайте здесь localhost:
# значение из .env перебивает умолчание, и прокси пойдёт в сам web. Нужно только для web вне compose (адрес API, достижимый из web).
# API_INTERNAL_URL="http://api:3000"
WEB_PORT=80
# ОБЯЗАТЕЛЬНО в production: внешний адрес веба, который увидят получатели писем (ссылки-приглашения). Без него API не стартует.
WEB_BASE_URL="https://app.example.com"
# Стенд по http (например, в LAN) — браузер не сохранит Secure-cookie: поставьте false. За HTTPS оставьте пустым.
COOKIE_SECURE=""

# POSTGRES (for docker-compose.server.yml)
POSTGRES_DB="afterlight"
POSTGRES_USER="afterlight"
POSTGRES_PASSWORD="change-me-strong-password"
