# API
DATABASE_URL="postgresql://afterlight:afterlight@db:5432/afterlight?schema=public"
JWT_SECRET="replace-with-64-char-random-hex-key-like-4f8b2d6a9c1e3f7b0d2a4c6e8f1a3b5d7c9e0a2b4d6f8a1c3e5b7d9f0a2c4e6"
NODE_ENV="production"
PORT=3000
DEFAULT_DEBUG_USER=""
# Адреса веба (через запятую). Тот же список — доверенные Origin для запросов, меняющих состояние (защита от CSRF)
CORS_ALLOWED_ORIGINS="http://localhost:3001"
JSON_BODY_LIMIT="100kb"

# WEB
# web проксирует /api/* в API. В docker-compose.server.yml по умолчанию http://api:3000 — НЕ задавайте здесь localhost:
# значение из .env перебивает умолчание, и прокси пойдёт в сам web. Нужно только для web вне compose (адрес API, достижимый из web).
# API_INTERNAL_URL="http://api:3000"
WEB_PORT=80
# ОБЯЗАТЕЛЬНО в production: внешний адрес веба, который увидят получатели писем (ссылки-приглашения). Без него API не стартует.
WEB_BASE_URL="https://app.example.com"
# Стенд по http (например, в LAN) — браузер не сохранит Secure-cookie: поставьте false. За HTTPS оставьте пустым.
COOKIE_SECURE=""

# MAIL (SMTP). В production обязательны MAIL_FROM и MAIL_SMTP_HOST — без них API не стартует; домены example.*/localhost запрещены.
# Без реальной почты письма (приглашения, восстановление пароля) остаются в очереди и повторяются с backoff — «Sent» ставится
# только после приёма письма SMTP-сервером. Для локальной разработки используйте Mailpit (docker-compose.dev.yml): значения по умолчанию.
MAIL_FROM="AfterLight <no-reply@your-domain.invalid>"
MAIL_SMTP_HOST="smtp.your-domain.invalid"
MAIL_SMTP_PORT=587
# required — обязательный STARTTLS (по умолчанию в production); opportunistic — если сервер предлагает; none — без шифрования (только sandbox/доверенная сеть)
MAIL_SMTP_TLS=required
# MAIL_SMTP_SECURE=true   # TLS с первого байта (порт 465)
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# Очередь: число попыток до Failed (12) и базовая/максимальная задержка повтора в секундах (30 → 3600, удвоение)
# MAIL_MAX_ATTEMPTS=12
# MAIL_RETRY_BASE_SECONDS=30
# MAIL_RETRY_MAX_SECONDS=3600
# MAIL_DISPATCH_INTERVAL_MS=15000   # 0 — выключить фоновую отправку

# POSTGRES (for docker-compose.server.yml)
POSTGRES_DB="afterlight"
POSTGRES_USER="afterlight"
POSTGRES_PASSWORD="change-me-strong-password"
